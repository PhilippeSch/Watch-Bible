      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers %lld angefragt, Kapitelende gezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verse %lld requested, end of chapter shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versículo %lld solicitado; se muestra el final del capítulo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verset %lld demandé ; fin du chapitre affichée."
          }
