    "divergence.clamped %lld": {
      "comment": "Vers existiert nicht, Kapitelende gezeigt. %lld = angefragter Vers",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vers %lld angefragt, Kapitelende gezeigt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verse %lld requested, end of chapter shown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Versículo %lld solicitado; se muestra el final del capítulo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verset %lld demandé ; fin du chapitre affichée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所求第 %lld 节不存在，显示本章末节。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所求第 %lld 節不存在，顯示本章末節。"
          }
        }
