    "about.noNetwork": {
      "comment": "Hinweis im Impressum",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die App arbeitet vollständig auf dem Gerät und sendet keine Daten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app works entirely on device and sends no data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app funciona por completo en el dispositivo y no envía datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’app fonctionne entièrement sur l’appareil et n’envoie aucune donnée."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本应用完全在设备上运行，不会发送任何数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本應用程式完全在裝置上運作，不會傳送任何資料。"
          }
        }
      }
    },
